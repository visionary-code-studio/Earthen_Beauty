# ==========================================
# EARTHEN BEAUTY - ENVIRONMENT CONFIGURATION
# ==========================================

# Port for the server
PORT=8000

# Security Key for JWT session tokens (Change to any random long string)
JWT_SECRET=earthen_beauty_super_secure_jwt_secret_2026_luxury

# ==========================================
# RAZORPAY CONFIGURATION
# Get keys from: https://dashboard.razorpay.com/#/app/keys
# Use test keys (rzp_test_...) for sandbox or live keys (rzp_live_...) for production
# ==========================================
RAZORPAY_KEY_ID=rzp_test_earthenbeauty_demo
RAZORPAY_KEY_SECRET=demo_secret_key_12345

# ==========================================
# SHIPROCKET CONFIGURATION
# Create API user at: https://app.shiprocket.in/api-user
# ==========================================
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
